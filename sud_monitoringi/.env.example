# --- Asosiy ---
DEBUG=0
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing
ALLOWED_HOSTS=sud-monitoring.example.uz
CSRF_TRUSTED_ORIGINS=https://sud-monitoring.example.uz
SITE_URL=https://sud-monitoring.example.uz
# HTTPS reverse-proxy (nginx) orqasida ishlaganda
BEHIND_PROXY=1
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# --- Ma'lumotlar bazasi (PostgreSQL) ---
DB_ENGINE=postgres
DB_NAME=sud_monitoringi
DB_USER=sud_monitoringi
DB_PASSWORD=kuchli-parol
DB_HOST=localhost
DB_PORT=5432
# SQLite uchun: DB_ENGINE=sqlite (SQLITE_PATH ixtiyoriy)

# --- Fayllar ---
# MEDIA_ROOT=/var/lib/sud_monitoringi/media
# BACKUP_ROOT=/var/lib/sud_monitoringi/backups
# REPORTS_ROOT=/var/lib/sud_monitoringi/reports
DOCUMENT_MAX_SIZE_MB=25

# --- Elektron pochta orqali xabarnomalar (ixtiyoriy) ---
EMAIL_NOTIFICATIONS=0
EMAIL_HOST=smtp.example.uz
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=sud-monitoring@example.uz

# --- Monitoring parametrlari ---
HEARING_REMINDER_DAYS=3
DEADLINE_REMINDER_DAYS=5
STALE_CASE_DAYS=30
BACKUP_HOUR=2
INTEGRATION_HTTP_TIMEOUT=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_COOKIE_AGE=28800
